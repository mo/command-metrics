#!/usr/bin/env bash
#
# Run dlspeedtest (~/bin/bin-public) as a command-metrics metric, on a
# schedule and with a back-off, so the servers never get hammered.
#
# Usage:  dlspeedtest-metric --every MIN [--at MIN] --name NAME -- DLSPEEDTEST_ARGS...
#
#   --every MIN  measure every MIN minutes (cron runs us every 5 minutes)
#   --at MIN     offset within that period, so different URLs can take turns,
#                e.g. --every 10 --at 5 measures at :05, :15, :25, ...
#   --name NAME  identifies the back-off state file
#
# Always prints a number on stdout: the speed in MB/s, or -1 when there is
# no measurement (not our turn, backing off, or the download failed). Pair
# it with "require": { "value": { "above": -0.5 } } so -1 is discarded.
# Printing nothing would crash command-metrics' "require" check.
#
# On HTTP 429 (rate limited) it stops measuring that NAME for an hour.
# Errors go to stderr with a timestamp, so redirect stderr to the log.

set -uo pipefail

BACKOFF_SECONDS=3600
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dlspeedtest-metric"

every=""; at=0; name=""
while [ $# -gt 0 ]; do
    case "$1" in
        --every) every="${2:-}"; shift 2 ;;
        --at)    at="${2:-}"; shift 2 ;;
        --name)  name="${2:-}"; shift 2 ;;
        --) shift; break ;;
        *) echo "dlspeedtest-metric: unknown argument: $1" >&2; echo -1; exit 0 ;;
    esac
done
if [ -z "$every" ] || [ -z "$name" ] || [ $# -eq 0 ]; then
    echo "usage: dlspeedtest-metric --every MIN [--at MIN] --name NAME -- DLSPEEDTEST_ARGS..." >&2
    echo -1
    exit 0
fi

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [dlspeedtest-metric $name] $*" >&2; }

# Is it our turn? Round the minute down to the 5-minute cron slot first, so
# a run that starts a little late still counts as its slot.
minute=$(date +%M)
if ! awk -v m="$minute" -v every="$every" -v at="$at" \
        'BEGIN { exit !((int(m / 5) * 5) % every == at) }'; then
    echo -1
    exit 0
fi

state_file="$STATE_DIR/$name.blocked-until"
now=$(date +%s)
if [ -f "$state_file" ]; then
    blocked_until=$(cat "$state_file" 2>/dev/null)
    case "$blocked_until" in
        ''|*[!0-9]*) rm -f "$state_file" ;;
        *) if [ "$now" -lt "$blocked_until" ]; then echo -1; exit 0; fi
           rm -f "$state_file" ;;
    esac
fi

errfile=$(mktemp "${TMPDIR:-/tmp}/dlspeedtest-metric.XXXXXX")
trap 'rm -f "$errfile"' EXIT

if value=$(dlspeedtest "$@" 2>"$errfile") && [ -n "$value" ]; then
    printf '%s\n' "$value"
    exit 0
fi

err=$(tr '\n' ' ' < "$errfile")
case "$err" in
    *"HTTP 429"*)
        mkdir -p "$STATE_DIR"
        echo $(( now + BACKOFF_SECONDS )) > "$state_file"
        log "rate limited (HTTP 429), not measuring for $(( BACKOFF_SECONDS / 60 )) minutes: $err"
        ;;
    *)
        log "measurement failed: ${err:-no output from dlspeedtest}"
        ;;
esac
echo -1
exit 0
